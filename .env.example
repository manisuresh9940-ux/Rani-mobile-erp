# ── Rani Mobiles ERP — .env.example ─────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
#
# Usage:
#   cp .env.example .env
#   nano .env    # fill in your values
#
# The application reads these values via src/config/config.php.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Rani Mobiles ERP"
APP_ENV=production       # "development" | "production"
APP_DEBUG=false          # true = show errors on screen (development only!)
APP_URL=https://ranimobile.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rani_erp
DB_USER=rani_user
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_PATH=/path/to/project/logs/app.log   # absolute path recommended
